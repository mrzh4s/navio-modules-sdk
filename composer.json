{
    "name": "navio/sdk",
    "description": "SDK for building external Navio modules",
    "type": "library",
    "license": "MIT",
    "version": "1.3.5",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.11.2",
        "illuminate/support": "^13.11.2"
    },
    "autoload": {
        "psr-4": {
            "Navio\\SDK\\": "src/"
        }
    },
    "extra": {
        "navio": {
            "sdk-version": "1.3.5",
            "api-level": 1,
            "min-host-version": "1.6.0"
        }
    }
}
